<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_edit_project_crm_enhancement" model="ir.ui.view">
        <field name="name">view.edit.project.crm.enhancement</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_start']" position="after">
                <field name="team_ids" string="Team" widget="many2many_tags_avatar" placeholder="Team Members"/>
            </xpath>
        </field>
    </record>
</odoo>
