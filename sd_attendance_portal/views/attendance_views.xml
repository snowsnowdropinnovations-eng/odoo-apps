        <template id="portal_layout_inherit" name="Portal Layout Inherit" inherit_id="portal.portal_layout">
            <xpath expr="//div[hasclass('wrapper')]//button" position="before">
                <button id="attendanceBtn" class="btn btn-warning attendanceBtn">
                    <span id="btnText">Check In</span>
                    <i class="fa fa-sign-in" aria-hidden="true"></i>
                </button>
            </xpath>
        </template>

        <record model="ir.actions.server" id="action_hr_employee_create_portal_user">
            <field name="name">Create Portal User</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="group_ids" eval="[(4, ref('base.group_erp_manager'))]"/>
            <field name="binding_model_id" ref="hr.model_hr_employee" />
            <field name="state">code</field>
            <field name="binding_view_types">form</field>
            <field name="code">
                action = records.action_create_portal_user()
            </field>
        </record>
    </data>
</odoo>